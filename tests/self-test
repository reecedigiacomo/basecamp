#!/bin/sh
# Template self-test: for each language in languages/, generates a project from the
# working tree (uncommitted changes included) into a temp folder, runs `just check` in it,
# then runs the language's own checks (languages/<language>/self-test, if any).
# A language whose tools (languages/<language>/tools) aren't on PATH is skipped with a
# warning. With SELF_TEST_ALL_LANGUAGES=1, as in BaseCamp's CI, a missing tool fails instead.
set -eu

repo=$(cd "$(dirname "$0")/.." && pwd)

for tool in uv just git; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "self-test: '$tool' is not on PATH. Install it, or add it to PATH, then rerun." >&2
    exit 1
  fi
done

work=$(mktemp -d "${TMPDIR:-/tmp}/basecamp-self-test.XXXXXX")
trap 'rm -r -f "$work"' EXIT
# An interrupt stops the run with a failing status; exiting runs the cleanup above.
trap 'exit 130' INT
trap 'exit 143' TERM

failures=0
fail() {
  echo "FAIL: $1" >&2
  failures=$((failures + 1))
}

generate() { # generate <language> <dest> [project_name] [lfs]
  # --vcs-ref=HEAD makes Copier include uncommitted changes in the working tree.
  uvx copier copy --quiet --trust --defaults --vcs-ref=HEAD \
    --data "project_name=${3:-sample-parser}" \
    --data "description=A sample parser" \
    --data "language=$1" \
    --data github_owner=octocat \
    --data "lfs=${4:-false}" \
    "$repo" "$2"
}

# expect_failure <what> <expected output> <command>...: the command must fail and print the expected text.
expect_failure() {
  what=$1 expected=$2
  shift 2
  if output=$("$@" 2>&1); then
    fail "$what passed"
  else
    case $output in
      *"$expected"*) echo "ok   $what fails" ;;
      *) echo "$output" >&2; fail "$what failed without '$expected'" ;;
    esac
  fi
}

refuse() { # refuse <language> <project_name>: Copier must refuse the name.
  if generate "$1" "$work/refused-$1-$2" "$2" >/dev/null 2>&1; then
    fail "copier accepted project_name=$2 for $1"
  else
    echo "ok   refused $1: $2"
  fi
}

languages=""
for dir in "$repo"/languages/*/; do
  language=$(basename "$dir")
  languages="$languages $language"
  missing=""
  for tool in $(cat "$dir/tools"); do
    if ! command -v "$tool" >/dev/null 2>&1; then
      missing=$tool
      break
    fi
  done
  if [ -n "$missing" ]; then
    if [ "${SELF_TEST_ALL_LANGUAGES:-}" = 1 ]; then
      fail "$language: '$missing' is not on PATH"
    else
      echo "WARNING: self-test: skipping $language, because '$missing' is not on PATH." >&2
    fi
    continue
  fi

  echo "== $language"
  project="$work/$language"
  generate "$language" "$project"
  (cd "$project" && just check) || fail "just check in the generated $language project"
  for recipe in fmt lint test check; do
    just --justfile "$project/justfile" --show "$recipe" >/dev/null 2>&1 ||
      fail "the generated $language justfile has no '$recipe' recipe"
  done
  grep -q 'check.yml' "$project/.github/workflows/ci.yml" &&
    fail "the generated $language CI workflow calls a shared check.yml"
  if [ -f "$dir/self-test" ]; then
    . "$dir/self-test"
  fi
done

echo "== the core names no language"
for language in $languages; do
  if grep -r -l -i -w "$language" "$repo/template" "$repo/tests/self-test" "$repo/justfile" "$repo/.github"; then
    fail "the core files above name $language"
  fi
done

echo "== Git LFS question"
# Any language will do: the question is the same for all of them.
first_language=${languages# }
first_language=${first_language%% *}
generate "$first_language" "$work/no-lfs" sample-parser false
[ -e "$work/no-lfs/.gitattributes" ] && fail "lfs=false wrote .gitattributes"
generate "$first_language" "$work/lfs" sample-parser true
if grep -q 'filter=lfs' "$work/lfs/.gitattributes" 2>/dev/null; then
  echo "ok   lfs=true writes .gitattributes"
else
  fail "lfs=true wrote no .gitattributes with LFS patterns"
fi

echo "== project names the core validator refuses"
# These fail the core check in copier.yml before any name-check.jinja runs, so one
# language covers them. Each language's own self-test checks its name-check.jinja.
refuse "$first_language" 1-starts-with-a-digit
refuse "$first_language" ends-with-

if [ "$failures" -gt 0 ]; then
  echo "self-test: $failures failure(s)" >&2
  exit 1
fi
echo "self-test: all checks passed"
