#!/bin/sh
# Template self-test: generates a Python and a Rust project from the working tree
# (uncommitted changes included) into a temp folder, runs `just check` in each,
# and checks the force-push hook. Never skips a language: a missing tool fails.
set -eu

repo=$(cd "$(dirname "$0")/.." && pwd)

for tool in uv cargo just jq git; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "self-test: '$tool' is not on PATH. Install it, or add it to PATH, then rerun." >&2
    exit 1
  fi
done

work=$(mktemp -d "${TMPDIR:-/tmp}/basecamp-self-test.XXXXXX")
trap 'rm -r -f "$work"' EXIT INT TERM

failures=0
fail() {
  echo "FAIL: $1" >&2
  failures=$((failures + 1))
}

generate() { # generate <language> <dest> [project_name]
  # --vcs-ref=HEAD makes Copier include uncommitted changes in the working tree.
  uvx copier copy --quiet --trust --defaults --vcs-ref=HEAD \
    --data "project_name=${3:-sample-parser}" \
    --data "description=A sample parser" \
    --data "language=$1" \
    --data github_owner=octocat \
    "$repo" "$2"
}

for language in python rust; do
  echo "== $language"
  generate "$language" "$work/$language"
  (cd "$work/$language" && just check) || fail "just check in the generated $language project"
done

grep -q cargo "$work/python/justfile" && fail "the Python justfile mentions cargo"
grep -q uv "$work/rust/justfile" && fail "the Rust justfile mentions uv"

echo "== force-push hook"
hook="$work/python/.claude/hooks/block-force-push"
expect() { # expect <allow|block> <command>
echo "== project names that would break the project"
refuse() { # refuse <language> <project_name>
  if generate "$1" "$work/refused-$1-$2" "$2" >/dev/null 2>&1; then
    fail "copier accepted project_name=$2 for $1"
  else
    echo "ok   refused $1: $2"
  fi
}
refuse python class
refuse python json
refuse python pytest
refuse rust std

  printf '%s' "$2" | jq -Rs '{tool_name: "Bash", tool_input: {command: .}}' \
    | "$hook" >/dev/null 2>&1 && code=0 || code=$?
  case "$1:$code" in
    allow:0 | block:2) echo "ok   $1: $2" ;;
    *) fail "hook should $1 (exit $code): $2" ;;
  esac
}
expect block 'git push --force'
expect block 'git push -f'
expect block 'git push --force-with-lease origin main'
expect block 'git push --force-with-lease origin feature/x'
expect block 'git push origin +brief/12-parser'
expect block 'git push --force-with-lease'
expect block 'cd sub && git -C . push --force origin brief/12-parser'
expect allow 'git push --force-with-lease origin brief/12-parser'
expect allow 'git push'
expect allow 'git status && git log -5'

if [ "$failures" -gt 0 ]; then
  echo "self-test: $failures failure(s)" >&2
  exit 1
fi
echo "self-test: all checks passed"
