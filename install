#!/usr/bin/env bash
# Set up this machine for BaseCamp: link its skills and practices.md into ~/.claude,
# and check for the tools it needs. Shows a plan first. Asks before linking a skill you
# didn't name with --skills, replacing anything, or installing a tool.
# practices.md is linked without asking: the BaseCamp skills read it.
# Safe to rerun: anything already in place is left alone.
set -euo pipefail
set -f  # no globbing: names from the command line are split unquoted, and "*" must stay "*"

physical() {  # physical <path>: the real path with every link resolved, or empty if it doesn't exist
  # Every step uses cd -P, so ".." inside a link target is resolved physically, not textually.
  local p="$1" target dir hops=0
  while [ -L "$p" ] && [ "$hops" -lt 40 ]; do
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *) dir="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd -P)" || return 0
         p="$dir/$target" ;;
    esac
    hops=$((hops + 1))
  done
  # A folder we can't enter (mode 000) is resolved through its parent instead.
  if [ -d "$p" ] && (cd -P "$p" 2>/dev/null && pwd -P); then
    return 0
  elif [ -e "$p" ]; then
    dir="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd -P)" && echo "$dir/$(basename "$p")"
  fi
  return 0
}

# Resolve the script itself first, so running it through a link still finds the clone.
REPO="$(dirname "$(physical "${BASH_SOURCE[0]}")")"
SKILLS_DIR="$HOME/.claude/skills"
BASECAMP_DIR="$HOME/.claude/basecamp"
BACKUP_DIR="$BASECAMP_DIR/backup"
ALL_SKILLS="agent-brief implementation-loop pr-review grill-me grilling"
ALL_TOOLS="copier just rustup gh"
DRY_RUN=0
SKILLS_SEL=""   # empty: ask about each new skill
TOOLS_SEL=""    # empty: ask about each missing tool

# Where Homebrew puts rustup. It's keg-only, so it's off PATH. Empty without Homebrew.
# Homebrew's own prefix, not "brew --prefix rustup", which can fetch formula data and is slow.
BREW_RUSTUP=""
if command -v brew >/dev/null 2>&1; then
  BREW_RUSTUP="$(brew --prefix 2>/dev/null || true)/opt/rustup/bin/rustup"
fi

usage() {
  cat <<EOF
Usage: ./install [options]

  --dry-run             Show the plan and change nothing.
  --skills <list|none>  Link only these skills, or none. Still asks before linking a skill
                        they need, or replacing anything in the way.
  --tools <list|none>   Offer only these missing tools, or none.
  --skills-dir <path>   Where to link skills (default: ~/.claude/skills).
  -h, --help            Show this help.

Lists are comma- or space-separated.
Skills: $(echo $ALL_SKILLS | sed 's/ /, /g')
Tools:  $(echo $ALL_TOOLS | sed 's/ /, /g')

practices.md is always linked at ~/.claude/basecamp/practices.md: the BaseCamp skills read it.
The links point into this clone, so keep it where it is. After moving it, rerun ./install:
broken links are repaired by default.
EOF
}

name_list() {  # name_list <flag> <value>: the names as one comma-separated list
  local list
  list="$(printf '%s' "$2" | tr -s ', \t\n' ',,,,' | sed 's/^,//; s/,$//')"
  if [ -z "$list" ]; then echo "$1 needs at least one name, or none" >&2; exit 2; fi
  echo "$list"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --skills) SKILLS_SEL="$(name_list --skills "${2-}")"; shift ;;
    --tools) TOOLS_SEL="$(name_list --tools "${2-}")"; shift ;;
    --skills-dir) SKILLS_DIR="${2:?--skills-dir needs a path}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

check_names() {  # check_names <flag> <comma-separated list> <allowed, space-separated>
  local name
  [ -z "$2" ] || [ "$2" = none ] && return 0
  for name in $(echo "$2" | tr ',' ' '); do
    case " $3 " in
      *" $name "*) ;;
      *) echo "Unknown name in $1: $name" >&2; usage >&2; exit 2 ;;
    esac
  done
}
check_names --skills "$SKILLS_SEL" "$ALL_SKILLS"
check_names --tools "$TOOLS_SEL" "$ALL_TOOLS"

skill_src() {
  case "$1" in
    grill-me|grilling) echo "$REPO/skills/third-party/mattpocock/$1" ;;
    *) echo "$REPO/skills/$1" ;;
  esac
}

skill_needs() {
  case "$1" in
    implementation-loop) echo "pr-review" ;;
    agent-brief) echo "grill-me grilling" ;;
    grill-me) echo "grilling" ;;
  esac
}

tool_install_cmd() {
  case "$1" in
    copier) echo "uv tool install copier" ;;
    just) echo "brew install just" ;;
    rustup) echo "brew install rustup" ;;
    gh) echo "brew install gh" ;;
  esac
}

tool_needs() {  # the installer a tool's command relies on
  case "$1" in
    copier) echo "uv" ;;
    *) echo "brew" ;;
  esac
}

rustup_bin() {  # the rustup to use: the one on PATH, else Homebrew's keg-only one
  if command -v rustup 2>/dev/null; then
    return 0
  elif [ -n "$BREW_RUSTUP" ] && [ -x "$BREW_RUSTUP" ]; then
    echo "$BREW_RUSTUP"
  fi
}

rustup_path_line() {  # the one PATH line to suggest for Homebrew's rustup
  echo "export PATH=\"$(dirname "$BREW_RUSTUP"):\$PATH\""
}

# installed, keg (rustup installed off PATH), no-toolchain (rustup without a toolchain), or missing
tool_state() {
  local bin
  if [ "$1" = rustup ] && bin="$(rustup_bin)" && [ -n "$bin" ]; then
    if "$bin" toolchain list 2>/dev/null | grep -q 'no installed toolchains'; then
      echo no-toolchain
    elif command -v rustup >/dev/null 2>&1; then
      echo installed
    else
      echo keg
    fi
  elif command -v "$1" >/dev/null 2>&1; then
    echo installed
  else
    echo missing
  fi
}

setup_toolchain() {  # Runs "rustup default stable". A failure is reported, never fatal.
  local bin
  bin="$(rustup_bin)"
  "$bin" default stable || echo "  rustup: toolchain setup failed. Run it yourself: $bin default stable"
}

inside_repo() {  # inside_repo <path>: true if <path> resolves into this repo, or would once created
  local p="$1" rest=""
  # Resolve the nearest part that exists, so nothing has to be created to check.
  while [ ! -e "$p" ] && [ ! -L "$p" ]; do
    rest="/$(basename "$p")$rest"
    p="$(dirname "$p")"
  done
  case "$(physical "$p")$rest/" in
    "$REPO"/*) return 0 ;;
    *) return 1 ;;
  esac
}

# ok: already resolves to the source. missing: nothing there. broken: a link to something that no
# longer exists (for example, after the clone moved). other-link: a link to somewhere else.
# exists: a real file or folder in the way.
# These three can't be linked, so they're never acted on: no-source: the source is missing from
# this clone. in-repo: its folder resolves into this repo. dead-folder: its folder is a link to
# nothing, so nothing can go there.
link_state() {
  local dest="$1" src="$2"
  if [ ! -e "$src" ]; then
    echo no-source
  elif [ -e "$dest" ] && [ "$(physical "$dest")" = "$(physical "$src")" ]; then
    echo ok
  elif [ -L "$(dirname "$dest")" ] && [ ! -e "$(dirname "$dest")" ]; then
    echo dead-folder
  elif inside_repo "$(dirname "$dest")"; then
    echo in-repo
  elif [ -L "$dest" ] && [ ! -e "$dest" ]; then
    echo broken
  elif [ -L "$dest" ]; then
    echo other-link
  elif [ -e "$dest" ]; then
    echo exists
  else
    echo missing
  fi
}

skill_state() { link_state "$SKILLS_DIR/$1" "$(skill_src "$1")"; }

settled() {  # settled <state>: true if there's nothing install can do about it
  case "$1" in ok|no-source|in-repo|dead-folder) return 0 ;; *) return 1 ;; esac
}

in_list() {  # in_list <item> <comma-separated list>
  case ",$2," in *",$1,"*) return 0 ;; *) return 1 ;; esac
}

ask() {  # ask <question> <default y|n>
  local prompt ans
  if [ "$2" = y ]; then prompt="[Y/n]"; else prompt="[y/N]"; fi
  printf '%s %s ' "$1" "$prompt"
  if ! read -r ans; then ans=""; echo; fi
  [ -z "$ans" ] && ans="$2"
  case "$ans" in y|Y|yes|Yes) return 0 ;; *) return 1 ;; esac
}

describe() {  # describe <state> <dest> <src>
  case "$1" in
    ok) echo "linked" ;;
    missing) echo "not linked" ;;
    no-source) echo "can't link: $3 is missing from this clone" ;;
    broken) echo "broken link ($(readlink "$2") is gone): will repair" ;;
    dead-folder) echo "can't link: $(dirname "$2") is a link to $(readlink "$(dirname "$2")"), which is gone" ;;
    other-link) echo "links elsewhere ($(readlink "$2")): needs your OK to replace" ;;
    exists) echo "a real file or folder is in the way: needs your OK to replace" ;;
    in-repo) echo "can't link: its folder resolves into this repo" ;;
  esac
}

replace_with_link() {  # replace_with_link <src> <dest>: callers have checked link_state first
  local src="$1" dest="$2" saved
  if ! mkdir -p "$(dirname "$dest")" 2>/dev/null; then
    echo "  can't link $dest: couldn't create $(dirname "$dest")."
    return 0
  fi
  if [ -L "$dest" ]; then
    # A link holds nothing but its target, so print that instead of keeping a copy.
    echo "  replaced a link to $(readlink "$dest")"
    rm "$dest"
  elif [ -e "$dest" ]; then
    # Only a real file or folder is kept, moved whole into the backup folder.
    if inside_repo "$BACKUP_DIR"; then
      echo "  refusing to replace $dest: the backup folder $BACKUP_DIR resolves into this repo."
      return 0
    fi
    saved="$BACKUP_DIR/$(basename "$dest").$(date +%Y%m%d-%H%M%S)"
    if ! mkdir -p "$BACKUP_DIR" 2>/dev/null || ! mv "$dest" "$saved" 2>/dev/null; then
      echo "  can't replace $dest: couldn't move it to $saved. Move it yourself, then rerun ./install."
      return 0
    fi
    echo "  moved the old one to $saved"
  fi
  ln -s "$src" "$dest"
  echo "  linked $dest"
}

apply_link() {  # apply_link <name> <src> <dest>: link, asking first if something is in the way
  local name="$1" src="$2" dest="$3" state
  state="$(link_state "$dest" "$src")"
  settled "$state" && return 0
  case "$state" in
    missing) ;;
    broken) ask "$name: $(describe "$state" "$dest" "$src"). Repair it?" y || { echo "  left $name as is."; return 0; } ;;
    *) ask "$name: $(describe "$state" "$dest" "$src"). Replace it?" n || { echo "  left $name as is."; return 0; } ;;
  esac
  replace_with_link "$src" "$dest"
}

# ---- Plan ----

PRACTICES_SRC="$REPO/practices.md"
PRACTICES_DEST="$BASECAMP_DIR/practices.md"

echo "BaseCamp install plan"
echo
echo "Practices (always linked):"
printf '  %-22s %s\n' "practices.md" "$(describe "$(link_state "$PRACTICES_DEST" "$PRACTICES_SRC")" "$PRACTICES_DEST" "$PRACTICES_SRC")"
echo
echo "Skills (into $SKILLS_DIR):"
for s in $ALL_SKILLS; do
  printf '  %-22s %s\n' "$s" "$(describe "$(skill_state "$s")" "$SKILLS_DIR/$s" "$(skill_src "$s")")"
done
echo
echo "Tools:"
for t in $ALL_TOOLS; do
  case "$(tool_state "$t")" in
    installed) printf '  %-22s %s\n' "$t" "installed" ;;
    keg) printf '  %-22s %s\n' "$t" "installed, not on your PATH: add $(rustup_path_line)" ;;
    no-toolchain) printf '  %-22s %s\n' "$t" "installed, no toolchain yet: $(rustup_bin) default stable" ;;
    missing) printf '  %-22s %s\n' "$t" "missing: $(tool_install_cmd "$t")" ;;
  esac
done
echo

if [ "$DRY_RUN" = 1 ]; then
  echo "Dry run: nothing changed."
  exit 0
fi

# ---- Apply ----

apply_link practices.md "$PRACTICES_SRC" "$PRACTICES_DEST"

# Skills: decide which to link, offer missing dependencies, then link.
# Each skill is asked about at most once: DECLINED keeps a "no" from being asked again.
CHOSEN=""
DECLINED=""
for s in $ALL_SKILLS; do
  state="$(skill_state "$s")"
  settled "$state" && continue
  if [ "$SKILLS_SEL" = none ]; then continue; fi
  if [ -n "$SKILLS_SEL" ]; then
    in_list "$s" "$SKILLS_SEL" && CHOSEN="$CHOSEN $s"
  elif [ "$state" != missing ]; then
    CHOSEN="$CHOSEN $s"   # something's in the way: the replace question covers it
  elif ask "Link skill $s?" y; then
    CHOSEN="$CHOSEN $s"
  else
    DECLINED="$DECLINED $s"
  fi
done

for s in $CHOSEN; do
  for need in $(skill_needs "$s"); do
    case " $CHOSEN $DECLINED " in *" $need "*) continue ;; esac
    settled "$(skill_state "$need")" && continue
    if ask "$s needs $need. Link $need too?" y; then
      CHOSEN="$CHOSEN $need"
    else
      DECLINED="$DECLINED $need"
    fi
  done
done

for s in $CHOSEN; do
  apply_link "$s" "$(skill_src "$s")" "$SKILLS_DIR/$s"
done

# Warn about any linked skill whose dependency didn't end up linked.
for s in $ALL_SKILLS; do
  [ "$(skill_state "$s")" = ok ] || continue
  for need in $(skill_needs "$s"); do
    if [ "$(skill_state "$need")" != ok ]; then
      echo "  warning: $s won't work fully until BaseCamp's $need is linked."
    fi
  done
done

# Tools: ask before installing each missing one. Never run anything piped from the internet.
# A failed install is reported, and the rest of the run carries on.
for t in $ALL_TOOLS; do
  state="$(tool_state "$t")"
  case "$state" in missing|no-toolchain) ;; *) continue ;; esac
  if [ "$TOOLS_SEL" = none ]; then continue; fi
  if [ -n "$TOOLS_SEL" ] && ! in_list "$t" "$TOOLS_SEL"; then continue; fi
  if [ "$state" = no-toolchain ]; then
    ask "Set up rustup's stable toolchain with: $(rustup_bin) default stable?" n && setup_toolchain
    continue
  fi
  cmd="$(tool_install_cmd "$t")"
  needs="$(tool_needs "$t")"
  if ! command -v "$needs" >/dev/null 2>&1; then
    echo "  $t: install it yourself ($cmd needs $needs)."
    continue
  fi
  question="Install $t with: $cmd?"
  if [ "$t" = rustup ]; then question="Install rustup with: $cmd, then set up its stable toolchain?"; fi
  ask "$question" n || continue
  if ! sh -c "$cmd"; then
    echo "  $t: install failed. Run it yourself: $cmd"
    continue
  fi
  if [ "$t" = rustup ]; then
    if ! command -v rustup >/dev/null 2>&1; then
      echo "  rustup is installed but not on your PATH (Homebrew keeps it separate)."
      echo "  Add this to your shell profile: $(rustup_path_line)"
    fi
    setup_toolchain
  fi
done

echo
echo "Done. Rerun ./install anytime; anything already in place is left alone."
