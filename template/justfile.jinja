{% if language == 'python' -%}
fmt:
    uv run ruff format

lint:
    uv run ruff check

test:
    uv run pytest

# Checks everything without changing anything.
check:
    uv run ruff format --check
    uv run ruff check
    uv run pytest
{% elif language == 'rust' -%}
fmt:
    cargo fmt

lint:
    cargo clippy --all-targets -- -D warnings

test:
    cargo test

# Checks everything without changing anything.
check:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cargo test
{% elif language == 'godot' -%}
{% raw -%}
gdtoolkit := "gdtoolkit==4.5.0"
gut_version := "9.7.1"
# SHA-256 of the GUT release tarball. Update it with gut_version.
gut_sha256 := "6da99c4e9228d9bec3fb4bd1730a487770a989f0f511dac82a2897a964613385"

fmt:
    uvx --from {{ gdtoolkit }} gdformat .

lint:
    uvx --from {{ gdtoolkit }} gdlint .

# Fetches GUT into the gitignored addons/gut/ on first run (or when gut_version
# changes), imports the project headless so class_name scripts resolve, then runs GUT.
test:
    #!/bin/sh
    set -eu
    want=$(cat .godot-version)
    archive="https://godotengine.org/download/archive/$want-stable/"
    if ! command -v godot >/dev/null 2>&1; then
      echo "just test: 'godot' is not on PATH. Download Godot $want from $archive and add it to PATH." >&2
      exit 1
    fi
    have=$(godot --version)
    case $have in
      "$want".*) ;;
      *)
        echo "just test: this project pins Godot $want (in .godot-version), but 'godot' is $have." >&2
        echo "Download Godot $want from $archive, or move the project to $have by updating .godot-version and .godot-linux-sha256." >&2
        exit 1 ;;
    esac
    work=$(mktemp -d)
    trap 'rm -r -f "$work"' EXIT
    if ! grep -qs 'version="{{ gut_version }}"' addons/gut/plugin.cfg; then
      echo "Fetching GUT {{ gut_version }} into addons/gut/"
      curl --proto '=https' --tlsv1.2 -fsSL -o "$work/gut.tar.gz" \
        "https://github.com/bitwes/Gut/archive/refs/tags/v{{ gut_version }}.tar.gz"
      echo "{{ gut_sha256 }}  $work/gut.tar.gz" | shasum -a 256 -c - >/dev/null 2>&1 \
        || { echo "just test: the GUT download doesn't match gut_sha256." >&2; exit 1; }
      tar -xzf "$work/gut.tar.gz" -C "$work"
      rm -r -f addons/gut
      mkdir -p addons
      mv "$work/Gut-{{ gut_version }}/addons/gut" addons/gut
    fi
    godot --headless --import
    status=0
    godot --headless -s addons/gut/gut_cmdln.gd -gdir=res://test -ginclude_subdirs -gexit >"$work/gut.log" 2>&1 || status=$?
    cat "$work/gut.log"
    # GUT skips a test script that fails to parse (or whose dependencies do) and still passes.
    if grep -q 'Failed to load script "res://test/' "$work/gut.log"; then
      echo "just test: a test script failed to load. See the errors above." >&2
      exit 1
    fi
    exit "$status"

# Checks everything without changing anything.
check:
    uvx --from {{ gdtoolkit }} gdformat --check .
    uvx --from {{ gdtoolkit }} gdlint .
    just test
{% endraw -%}
{% endif -%}
