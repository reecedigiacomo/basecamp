{% if language == 'python' -%}
fmt:
    uv run ruff format

lint:
    uv run ruff check

test:
    uv run pytest

# Checks everything without changing anything.
check:
    uv run ruff format --check
    uv run ruff check
    uv run pytest
{% elif language == 'rust' -%}
fmt:
    cargo fmt

lint:
    cargo clippy --all-targets -- -D warnings

test:
    cargo test

# Checks everything without changing anything.
check:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cargo test
{% endif -%}
