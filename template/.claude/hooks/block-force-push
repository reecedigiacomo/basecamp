#!/bin/sh
# PreToolUse hook for Bash: blocks every force-push except --force-with-lease to
# brief/* branches. Reads the hook's JSON input on stdin; exit 2 blocks the call.
#
# A backstop for realistic mistakes, not a guarantee: branch protection on main
# is the real wall. It errs toward blocking: quotes are ignored and any command
# segment that runs `git ... push` is checked, so a force-push hidden in
# `sh -c "..."` is caught too. Anything it can't read from the command text (a
# shell expansion, inline config) blocks the push rather than guessing.

block() {
  echo "Blocked by .claude/hooks/block-force-push: $1" >&2
  echo "Only 'git push --force-with-lease <remote> brief/<branch>' may force-push." >&2
  exit 2
}

input=$(cat) || block "could not read the hook input."
if ! command -v jq >/dev/null 2>&1; then
  # Without jq the command can't be parsed, so block anything that could be a push.
  case $input in
    *push* | *send-pack*) block "jq is required to check commands that mention 'push'." ;;
    *) exit 0 ;;
  esac
fi
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty') ||
  block "could not read the hook input."
[ -n "$cmd" ] || exit 0

# Config given in the environment can force a push or define an alias.
case $cmd in
  *GIT_CONFIG*) has_git_config_env=1 ;;
  *) has_git_config_env="" ;;
esac

# check_push <args after "push">: blocks unless the push is allowed.
check_push() {
  force="" lease="" wide="" remote="" refspecs="" options_done=""
  while [ $# -gt 0 ]; do
    case $options_done$1 in
      *'$'* | *'{'*) block "the push's arguments contain a shell expansion ($1), which can't be checked." ;;
      --) options_done=1 ;;
      --no-*) ;;
      --*)
        # git accepts any unambiguous prefix of a long option (--mirr, --tag).
        opt=${1%%=*}
        case $opt in
          --force-*) case --force-with-lease in "$opt"*) lease=1 ;; esac ;;
          *)
            case --force in "$opt"*) force="$1" ;; esac
            case --mirror in "$opt"*) force="$1" ;; esac
            for wide_opt in --all --branches --tags --follow-tags; do
              case $wide_opt in "$opt"*) wide="$1" ;; esac
            done
            ;;
        esac
        ;;
      -o)
        [ $# -ge 2 ] && shift
        ;;
      -*f*) force="$1" ;;
      -*) ;;
      *)
        case $1 in +*) force="refspec $1" ;; esac
        if [ -z "$remote" ]; then remote=$1; else refspecs="$refspecs $1"; fi
        ;;
    esac
    shift
  done
  [ -n "$force" ] && block "force-push ($force)."
  [ -z "$lease" ] && return 0
  [ -n "$wide" ] && block "--force-with-lease with $wide pushes more than brief/* branches."
  [ -n "$refspecs" ] || block "--force-with-lease must name its remote and a brief/* branch."
  for refspec in $refspecs; do
    dest=${refspec#*:}
    dest=${dest#refs/heads/}
    case $dest in
      brief/?*) ;;
      *) block "--force-with-lease to '$dest', which is not a brief/* branch." ;;
    esac
  done
}

# check_segment <words of one simple command>: finds `git [global options] push`.
check_segment() {
  while [ $# -gt 0 ]; do
    case $1 in
      git | */git)
        shift
        [ -n "$has_git_config_env" ] && block "git run with GIT_CONFIG_* set, which can force a push."
        inline_config=""
        while [ $# -gt 0 ]; do
          case $1 in
            -c | --config-env)
              inline_config="$inline_config ${2:-}"
              [ $# -ge 2 ] && shift
              shift
              ;;
            --config-env=*)
              inline_config="$inline_config ${1#*=}"
              shift
              ;;
            -C | --git-dir | --work-tree | --namespace | --exec-path)
              [ $# -ge 2 ] && shift
              shift
              ;;
            -*) shift ;;
            *) break ;;
          esac
        done
        case $(printf '%s' "$inline_config" | tr '[:upper:]' '[:lower:]') in
          *alias.* | *'$'* | *'{'*) block "git -c$inline_config could hide a force-push." ;;
        esac
        case ${1:-} in
          *'$'* | *'{'*) block "the git subcommand is a shell expansion (${1:-}), which can't be checked." ;;
          send-pack) block "git send-pack can force-push; use git push." ;;
          push) ;;
          *) return 0 ;;
        esac
        [ -n "$inline_config" ] && block "git -c$inline_config on a push can force it."
        shift
        check_push "$@"
        return 0
        ;;
    esac
    shift
  done
}

# Split the command into simple commands. Line continuations are joined and
# quotes and backslashes dropped. `$` stays in its word so check_push sees the
# expansion; a backtick becomes `$` too, then both it and `(` end the segment.
# An unquoted redirection (`2>&1`, `> log`) is dropped with its target, since it
# never reaches git's arguments; a target holding a command substitution is kept
# so the command inside is checked.
set -f # no glob expansion when splitting words
segments=$(printf '%s\n' "$cmd" | awk '
  function put(c) {
    if (c == "`") out = out "$\n"
    else if (c ~ /[;&|()]/) out = out "\n"
    else out = out c
  }
  # redirect(i): line[i] starts a redirection; returns the index of its last character.
  function redirect(i,   start, q, c) {
    # An all-digit word right before the operator is its file descriptor.
    if (match(out, /[0-9]+$/) && (RSTART == 1 || substr(out, RSTART - 1, 1) ~ /[ \t\n]/))
      out = substr(out, 1, RSTART - 1)
    while (substr(line, i + 1, 1) ~ /[<>&]/) i++
    while (substr(line, i + 1, 1) ~ /[ \t]/) i++
    start = i; q = ""
    while (i < n) {
      c = substr(line, i + 1, 1)
      if (q != "") { if (c == q) q = "" }
      else if (c == "\"" || c == "\047") q = c
      else if (c ~ /[ \t;&|()<>]/) break
      i++
    }
    out = out " "
    if (substr(line, start + 1, i - start) ~ /`|\$\(/) return start
    return i
  }
  /\\$/ { sub(/\\$/, ""); joined = joined $0; next }
  {
    line = joined $0; joined = ""; out = ""; quote = ""; n = length(line)
    for (i = 1; i <= n; i++) {
      c = substr(line, i, 1)
      if (quote != "") {
        if (c == quote) quote = ""
        else if (c == "\\" && quote == "\"") put(substr(line, ++i, 1))
        else put(c)
      }
      else if (c == "\"" || c == "\047") quote = c
      else if (c == "\\") put(substr(line, ++i, 1))
      else if (c == ">" || c == "<") i = redirect(i)
      else put(c)
    }
    print out
  }
  END { if (joined != "") print joined }
')
old_ifs=$IFS
IFS='
'
for segment in $segments; do
  IFS=$old_ifs
  # shellcheck disable=SC2086 # split the segment into words on purpose
  check_segment $segment
done
exit 0
